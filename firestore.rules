rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isHouseholdMember(householdId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    match /households/{householdId} {
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members);
      allow delete: if false;
    }
    
    match /expenses/{expenseId} {
      allow create: if isHouseholdMember(request.resource.data.householdId);
      allow read, update, delete: if isHouseholdMember(resource.data.householdId);
    }
    
    match /shoppingLists/{listId} {
      allow create: if isHouseholdMember(request.resource.data.householdId);
      allow read, update, delete: if isHouseholdMember(resource.data.householdId);
    }
    
    match /participants/{participantId} {
      allow create: if isHouseholdMember(request.resource.data.householdId);
      allow read, update, delete: if isHouseholdMember(resource.data.householdId);
    }
    
    match /settings/{settingId} {
      allow create: if isHouseholdMember(request.resource.data.householdId);
      allow read, update, delete: if isHouseholdMember(resource.data.householdId);
    }
  }
}
